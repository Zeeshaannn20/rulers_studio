# Neon Postgres connection string (Neon dashboard → Connection details → Prisma)
# Leave empty to run without a database: form submissions are then only logged to the server console.
DATABASE_URL=""

# Public site URL, used for sitemap and social previews
NEXT_PUBLIC_SITE_URL="https://rulersstudio.com"

# Google Calendar booking page for "Schedule a Strategy Call" (leave empty until ready)
NEXT_PUBLIC_BOOKING_URL=""

# Strategy meet (₹99): Razorpay keys from Dashboard → Account & Settings → API Keys.
# Use rzp_test_… keys to try it, then switch to rzp_live_… keys.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Google Calendar booking link that opens after a successful payment
MEET_BOOKING_URL="https://calendar.app.google/u3giLNoQPEix5Bi59"

# Leads → Google Sheet ("Website Sales Call"): Apps Script web-app URL + the secret word set in apps-script/RulersLeads.gs
SHEETS_WEBHOOK_URL=""
SHEETS_SECRET=""
# Join the Crew applications → "Join the Crew" sheet (apps-script/RulersCrew.gs web-app URL; uses SHEETS_SECRET too)
CREW_SHEET_URL=""
# Google Search Console → Settings → Ownership verification → HTML tag → paste only the content="…" value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
