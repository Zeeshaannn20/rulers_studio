// Rulers Studio — database (Neon Postgres). Developer Brief, section 9.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnquiryStatus {
  NEW
  CONTACTED
  WON
  LOST
}

enum ApplicationStatus {
  NEW
  SHORTLISTED
  REJECTED
}

model Project {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  typeTag        String
  videoUrl       String?
  coverImage     String?
  previewClipUrl String?
  aspectRatio    String   @default("16:9")
  durationSec    Int?
  writeup        String?
  deliverables   String?
  industry       String?
  timeline       String?
  isConcept      Boolean  @default(false)
  homeOrder      Int?
  inReel         Boolean  @default(false)
  displayOrder   Int      @default(0)
  published      Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ClientLogo {
  id           String  @id @default(cuid())
  name         String
  logoImage    String?
  showOnSite   Boolean @default(false)
  displayOrder Int     @default(0)
}

model Role {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  summary          String
  responsibilities String[]
  requirements     String[]
  open             Boolean  @default(true)
  displayOrder     Int      @default(0)
}

model Enquiry {
  id             String        @id @default(cuid())
  name           String
  mobile         String
  services       String // requirements picked, comma-separated (e.g. "AI Ad Films, Other")
  projectDetails String? // filled when "Other" is picked
  brandName      String?
  email          String?
  budgetRange    String?
  sourcePage     String?
  utm            Json?
  status         EnquiryStatus @default(NEW)
  createdAt      DateTime      @default(now())
}

model Application {
  id           String            @id @default(cuid())
  fullName     String
  email        String
  phone        String
  roleSlug     String
  portfolioUrl String
  city         String?
  tools        String?
  expectedRate Int?
  why          String?
  status       ApplicationStatus @default(NEW)
  createdAt    DateTime          @default(now())
}
